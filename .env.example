# Deep Context Toolkit — Environment Variables
# Copy this file to tools/.env and fill in the values for each source you want to use.
# Not all sources are required — Gmail alone provides significant value.

# ──────────────────────────────────────────────
# Google OAuth (required for Gmail)
# Create a Google Cloud project → enable Gmail API → create OAuth credentials
# See: https://console.cloud.google.com/apis/credentials
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google tokens — auto-populated after running: bun tools/deep-context.ts extract gmail
# The first run triggers a device auth flow that generates these tokens.
GOOGLE_TOKEN=
GOOGLE_REFRESH_TOKEN=
GMAIL_TOKEN=
GMAIL_REFRESH_TOKEN=

# ──────────────────────────────────────────────
# Slack (optional — for Slack message extraction)
# Create a Slack app at api.slack.com/apps with these scopes:
#   channels:history, channels:read, groups:history, groups:read,
#   im:history, im:read, mpim:history, mpim:read, users:read,
#   users:read.email, files:read, search:read
# Install to each workspace and copy the bot/user tokens.
# ──────────────────────────────────────────────
# Use SLACK_BOT_TOKEN_<WORKSPACE_FLAG> naming convention.
# WORKSPACE_FLAG should match the keys in OWNER_CONFIG.slackIdentifiers.
# Example:
# SLACK_BOT_TOKEN_MYCOMPANY=xoxb-...
# SLACK_USER_TOKEN_MYCOMPANY=xoxp-...

# ──────────────────────────────────────────────
# Beeper (optional — for iMessage, WhatsApp, Signal extraction)
# Requires Beeper Desktop running locally.
# Open Beeper Desktop → Settings → Developers → Toggle "Beeper Desktop API" ON
# Click '+' next to 'Approved connections' to create a token.
# ──────────────────────────────────────────────
BEEPER_ACCESS_TOKEN=

# ──────────────────────────────────────────────
# GroupMe (optional — for GroupMe group/DM extraction)
# Token-only, no desktop app needed. Create an app and get an access token at:
# https://dev.groupme.com/  → "Access Token" (top right)
# First run should use --backfill to pull full history, then it goes incremental.
# ──────────────────────────────────────────────
GROUPME_ACCESS_TOKEN=

# ──────────────────────────────────────────────
# Twitter / X (optional — for LIVE tweet extraction via the official X API v2)
# Twitter ARCHIVE import needs NO credentials — just set extraction.twitter.archive_path
# in config.json. These keys are only needed for the live-fetch pass.
# Create an app at https://developer.x.com (Free tier covers reading your own tweets):
#   - API Key / API Secret      → consumer key/secret
#   - Access Token / Secret      → generate under "Keys and tokens" (user context)
#   - Bearer Token               → app-only (public lookups)
# ──────────────────────────────────────────────
X_API_CONSUMER_KEY=
X_API_CONSUMER_SECRET=
X_API_ACCESS_TOKEN=
X_API_ACCESS_TOKEN_SECRET=
X_API_BEARER_TOKEN=

# ──────────────────────────────────────────────
# Fireflies.ai (optional — for call/meeting transcript extraction)
# Requires Fireflies Business plan for API access.
# Get your API key from: https://app.fireflies.ai/integrations
# ──────────────────────────────────────────────
FIREFLIES_API_KEY=

# ──────────────────────────────────────────────
# Deepgram (optional — only for `calls retranscribe` re-transcription)
# Get an API key from: https://console.deepgram.com/
# ──────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ──────────────────────────────────────────────
# Gemini (required for enrichment and synthesis)
# Get an API key from: https://aistudio.google.com/apikey
# ──────────────────────────────────────────────
GEMINI_API_KEY=

# ──────────────────────────────────────────────
# Anthropic (optional — wiki-layer summaries (Claude is the documented default)
# and LLM-powered contact matching). Get a key from: https://console.anthropic.com/
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────
# OpenAI (optional — alternate summarizer for the wiki layer, gpt-* models)
# Get an API key from: https://platform.openai.com/api-keys
# ──────────────────────────────────────────────
OPENAI_API_KEY=
